# Copy this file to .env and fill in values for your machine.

APP_ENVIRONMENT=local
BIGQUERY_PROJECT_ID=dealer-contacts-project
BIGQUERY_DATASET=dealer_data
SOURCE_CONTACT_TABLE=contact_master
DEALER_ACCOUNTS_TABLE=dealer_accounts
PROSPECT_CONTACTS_TABLE=prospect_contacts
ACCOUNT_RELATIONSHIPS_TABLE=account_relationships
SYNC_TARGETS_TABLE=sync_targets
ACCOUNT_WORK_QUEUE_TABLE=account_work_queue
PIPELINE_RUNS_TABLE=pipeline_runs
ENRICHMENT_BATCH_SIZE=25
WORKER_BATCH_SIZE=50
WORKER_LEASE_MINUTES=30
VALIDATE_WORKER_BATCH_SIZE=50
ENRICH_WORKER_BATCH_SIZE=25
EXTRACT_WORKER_BATCH_SIZE=25
RETRY_BLOCKED_WORKER_BATCH_SIZE=10
CLOUD_RUN_REGION=us-central1
REQUEST_TIMEOUT_SECONDS=12
BROWSER_TIMEOUT_SECONDS=30
GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\your\service-account-key.json
